# ============================================================
#  Rainbow-AI — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to git (it is already in .gitignore).
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3001

# ── Auth ─────────────────────────────────────────────────────
# Generate a secure random secret: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# ── CORS ─────────────────────────────────────────────────────
# Dev: http://localhost:5173
# Prod: https://your-app.vercel.app  (or your custom domain)
ALLOWED_ORIGIN=http://localhost:5173

# ── Frontend (Vite) ──────────────────────────────────────────
# Must match where your Express server is running
VITE_API_URL=http://localhost:3001

# ── Google OAuth ─────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URIs: http://localhost:3001/api/auth/google/callback  (dev)
#                           https://your-api.com/api/auth/google/callback   (prod)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── AI / LLM ─────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Leave unset (or set to KEY_PENDING) to run in mock mode.
OPENAI_API_KEY=sk-your-openai-api-key

# ── Database ─────────────────────────────────────────────────
# Dev: SQLite (no DATABASE_URL needed — uses local database.sqlite file)
# Prod (future): PostgreSQL connection string from Supabase or Neon
# DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ── Error Monitoring (optional) ──────────────────────────────
# Create a project at https://sentry.io and paste the DSN here.
# The ErrorBoundary will automatically report frontend crashes.
# VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
